# ============================================================
# Stock Analysis System - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ── LLM 配置 ─────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_FALLBACK=qwen-plus,deepseek-chat
LLM_COST_TRACKING=false

# ── 分析深度：rapid / standard / deep ────────────────────────
ANALYSIS_PROFILE=rapid

# ── Agent 配置 ───────────────────────────────────────────────
AGENT_MAX_ITER=3
AGENT_ALLOW_DELEGATION=false
AGENT_VERBOSE=true

# ── Crew 配置 ────────────────────────────────────────────────
CREW_PROCESS=sequential
CREW_VERBOSE=false

# ── 缓存配置 ─────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL=86400

# ── Redis 配置（可选，未安装 redis 则自动降级为文件+内存） ──
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=stock_analysis
REDIS_ANALYSIS_TTL=86400
REDIS_COLLECTION_TTL=3600

# ── 并发与限流 ───────────────────────────────────────────────
MAX_WORKERS=2
API_RETRY_COUNT=3
API_RETRY_DELAY=1.0

# ── 数据源熔断配置 ───────────────────────────────────────────
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT=300
SOURCE_TIMEOUT=10

# ── 阶段超时（秒） ───────────────────────────────────────────
STAGE_TIMEOUT_DATA=180
STAGE_TIMEOUT_ANALYSIS=300
STAGE_TIMEOUT_DECISION=180

# ── 服务配置 ─────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ── 工具配置 ─────────────────────────────────────────────────
SERPER_API_KEY=your-serper-api-key-here
SERPER_ENABLED=true

# ── 数据过滤配置 ─────────────────────────────────────────────
FINANCIAL_DATA_YEARS=2

# ── 日志配置 ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s